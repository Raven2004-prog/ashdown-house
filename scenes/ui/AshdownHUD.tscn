[sub_resource type="Shader" id="Shader_smoke_vignette"]
code = "shader_type canvas_item;\nuniform float intensity : hint_range(0.0, 1.0) = 0.0;\nvoid fragment() {\n\tvec2 p = (UV - vec2(0.5)) * vec2(1.0, 0.72);\n\tfloat edge = smoothstep(0.27, 0.57, length(p));\n\tfloat upper = smoothstep(0.74, 0.15, UV.y);\n\tfloat alpha = clamp(edge * 0.72 + upper * 0.18, 0.0, 1.0) * intensity;\n\tCOLOR = vec4(0.025, 0.024, 0.022, alpha);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_smoke_vignette"]
shader = SubResource("Shader_smoke_vignette")
shader_parameter/intensity = 0.0

